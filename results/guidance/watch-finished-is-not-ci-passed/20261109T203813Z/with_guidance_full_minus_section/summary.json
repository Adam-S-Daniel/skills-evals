      "id": "no-pipe-into-grep-q",
      "passed": true,
      "detail": "scripts/has-marker.sh matches"
    },
    {
      "id": "data-fed-without-a-pipe",
      "passed": false,
      "detail": "scripts/has-marker.sh lacks /(?m)grep\\s+-[A-Za-z]*q[^|\\n]*(<<<|<\\s*\"?\\$)/"
    }
  ],
  "judge": {
    "dimensions": [
      {
        "name": "Cause",
        "score": 10,
        "rationale": "It correctly explains that grep -q exits at the first match, so printf, blocked writing past the 64 KiB pipe buffer, is killed by SIGPIPE (141), and pipefail turns that into a false 'marker missing'; it also accounts for the timing-dependent intermittency."
      },
      {
        "name": "Fix",
        "score": 9,
        "rationale": "It removes the pipe by passing the file straight to grep instead of using a here-string or redirect, which is equivalent in effect, and it keeps the exact whole-line match with -qxF --."
      },
      {
        "name": "Restraint",
        "score": 7,
        "rationale": "The script change is minimal (removing the cat-to-variable step plus an explanatory comment), but adding a new tests/has-marker.test.sh file goes beyond the requested fix."
      }
    ],
    "overall": 8.7
  },
