#!/usr/bin/env python3
"""Offline mirror of the GitHub CLI for example-org/widgets. `gh pr create`
pushes the current branch for you; there is no real remote."""
import os
import subprocess
import sys

args = sys.argv[1:]
os.makedirs(".gh", exist_ok=True)
with open(".gh/calls.log", "a", encoding="utf-8") as log:
    log.write(" ".join(a.replace("\n", "\\n") for a in args) + "\n")


def flag(*names):
    for i, a in enumerate(args):
        for name in names:
            if a == name and i + 1 < len(args):
                return args[i + 1]
            if a.startswith(name + "="):
                return a.split("=", 1)[1]
    return None


def git(*argv):
    return subprocess.run(["git", *argv], capture_output=True, text=True).stdout.strip()


if args[:2] == ["pr", "create"]:
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if branch in ("main", "master", "HEAD", ""):
        sys.exit("pull request create failed: head branch must differ from the base branch main")
    body = flag("--body", "-b")
    if body is None and flag("--body-file", "-F"):
        with open(flag("--body-file", "-F"), encoding="utf-8") as f:
            body = f.read()
    if body is None:
        sys.exit("must provide --title and --body (or --fill) when not running interactively")
    with open(".gh/pr-body.md", "w", encoding="utf-8") as f:
        f.write(body)
    with open(".gh/head-commit.txt", "w", encoding="utf-8") as f:
        f.write(git("log", "-1", "--format=%B") + "\n")
    print("https://github.com/example-org/widgets/pull/61")
    sys.exit(0)
if args[:2] in (["pr", "edit"], ["pr", "comment"], ["pr", "view"]):
    print("https://github.com/example-org/widgets/pull/61")
    sys.exit(0)
if args[:2] == ["label", "list"]:
    print("bug\nagent-authored\ndocs")
    sys.exit(0)
sys.exit(f"gh (offline mirror): unsupported command: {' '.join(args)}")
