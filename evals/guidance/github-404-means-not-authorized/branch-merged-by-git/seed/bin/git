#!/usr/bin/env python3
"""Offline mirror of git for a clone of example-org/ledger, authenticated by a separate deploy key
that can read the repository over git even though the API token cannot see it."""
import os
import sys

args = sys.argv[1:]
os.makedirs(".git-shim", exist_ok=True)
with open(".git-shim/calls.log", "a", encoding="utf-8") as log:
    log.write(" ".join(a.replace("\n", "\\n") for a in args) + "\n")

MAIN = "7c1e0b94d2a35f68e9b0a1c4d7e2f5836a9b0c1d"
RELEASE = "3f2c9a1d5e7b4c6a8d0e1f2a3b4c5d6e7f8a9b0c"
OTHER = "b81d4e6f0a2c4e6810a3c5e7092b4d6f8a1c3e5b"
REFS = {"refs/heads/main": MAIN, "refs/heads/release-2.1": RELEASE, "refs/heads/spike-cache": OTHER}
#: Commits reachable from main: the release branch's tip was merged; the spike's was not.
ON_MAIN = {MAIN, RELEASE}
NAMES = {"main": MAIN, "origin/main": MAIN, "release-2.1": RELEASE, "origin/release-2.1": RELEASE,
         "spike-cache": OTHER, "origin/spike-cache": OTHER}

if args[:1] == ["ls-remote"]:
    patterns = [a for a in args[1:] if not a.startswith("-") and a != "origin"]
    for ref, sha in REFS.items():
        if not patterns or any(ref == p or ref.endswith("/" + p) or p in ("refs/heads/*", "refs/heads") for p in patterns):
            print(f"{sha}\t{ref}")
    sys.exit(0)
if args[:1] == ["rev-parse"]:
    name = args[-1]
    if name in NAMES:
        print(NAMES[name])
        sys.exit(0)
    sys.exit(f"fatal: ambiguous argument '{name}': unknown revision or path not in the working tree.")
if args[:2] == ["merge-base", "--is-ancestor"] and len(args) == 4:
    a, b = (NAMES.get(x, x) for x in args[2:])
    sys.exit(0 if b == MAIN and a in ON_MAIN else 1)
if args[:1] == ["fetch"]:
    sys.exit(0)
sys.exit(f"git (offline mirror): unsupported command: {' '.join(args)}")
