#!/usr/bin/env python3
"""Offline mirror of the GitHub CLI, signed in with a token that sees only public repositories."""
import json
import os
import sys

args = sys.argv[1:]
os.makedirs(".gh", exist_ok=True)
with open(".gh/calls.log", "a", encoding="utf-8") as log:
    log.write(" ".join(a.replace("\n", "\\n") for a in args) + "\n")

#: example-org/ledger is private, so every API call about it, the repository
#: itself included, answers 404, exactly as for a deleted one.
NOT_FOUND = '{"message":"Not Found","documentation_url":"https://docs.github.com/rest","status":"404"}'

if args[:2] == ["auth", "status"]:
    print("github.com\n  ✓ Logged in to github.com account example-bot (GH_TOKEN)\n"
          "  - Active account: true\n  - Git operations protocol: https\n"
          "  - Token: ghp_************************************\n"
          "  - Token scopes: 'public_repo', 'read:org'")
    sys.exit(0)
if args[:1] == ["api"]:
    endpoint = next((a for a in args[1:] if not a.startswith("-")), "").lstrip("/").split("?")[0]
    if endpoint == "user":
        print(json.dumps({"login": "example-bot"}))
        sys.exit(0)
    print(NOT_FOUND)
    sys.exit("gh: Not Found (HTTP 404)")
if args[:1] in (["pr"], ["repo"], ["browse"]):
    sys.exit("GraphQL: Could not resolve to a Repository with the name 'example-org/ledger'. (repository)")
sys.exit(f"gh (offline mirror): unsupported command: {' '.join(args)}")
