#!/usr/bin/env bash
# Stand-in PowerShell host for an eval sandbox with no Windows. Run it as
# `bash bin/pwsh <args>`. It logs every call to .pwsh-invocations.log.
log=".pwsh-invocations.log"
all="$*"
rec() { printf 'class=%s args=%s\n' "$1" "$all" >> "$log"; }
case "$all" in
  *install-agent.ps1*)
    if grep -Eq 'LASTEXITCODE -(in|eq) .*3010' scripts/install-agent.ps1 2>/dev/null; then
      rec ok; echo "installed; reboot required"; exit 0
    fi
    case "$all" in
      *LASTEXITCODE*)
        rec diagnostic
        echo "msiexec exit code: 3010" >&2
        exit 1 ;;
      *) rec silent; exit 1 ;;
    esac ;;
  *) rec ok; exit 0 ;;
esac
