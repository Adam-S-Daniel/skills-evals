# Canary markdown is byte-locked (e2e/canary-content.test.js) and round-tripped
# through Decap; force LF so a CRLF commit can never wedge the byte-lock
# independently of the in-flight marker logic (#70 byte-lock hardening).
_e2e/*.md text eol=lf
e2e/fixture-site/_e2e/*.md text eol=lf
e2e/fixture-site-singlepage/**/*.md text eol=lf

# The vendored CloudWatch RUM client is hash-locked against the bytes AWS
# serves (e2e/analytics-rum-client-vendored.test.js); never let a checkout
# rewrite its line endings.
theme/assets/js/aws-rum-web/cwr-*.js -text

# The OAuth proxy reports sha256(lambda.py) from /prod/health, and the build
# probe compares it with the same digest of a CI checkout (#518). Pin LF so a
# CRLF checkout on a deploying workstation cannot read as a different build.
oauth-proxy/lambda.py text eol=lf
