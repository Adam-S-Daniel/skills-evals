# Per-site deploy parameters for the infrastructure/ and oauth-proxy/ stacks,
# AND the single source the repo-variable setter derives from. Copy to
# site-params.env, fill in, then before running any deploy.sh:
#   set -a; source infrastructure/site-params.env; set +a
# The scaffolder (scaffold/) generates this file for a new site.
#
# scripts/set-repo-variables.sh reads APEX_DOMAIN (+ the optional knobs below)
# from here and sets the consumer's GitHub Actions *repository variables*
# (CMS_APEX, CMS_PROD_URL, PREVIEW_BUCKET, AWS_REGION) the reusable workflows
# read via vars.* — so those values are never typed twice.

# ── Required ────────────────────────────────────────────────────────────────
export GITHUB_REPO="example.com"        # owner is GITHUB_ORG below
# A '*' in ALLOWED_ORIGINS (below) needs APEX_DOMAIN; an older site-params.env
# that lacks it must add this line before the next oauth-proxy deploy.
export APEX_DOMAIN="example.com"         # production apex (no scheme)

# ── OAuth proxy (oauth-proxy/deploy.sh) ──────────────────────────────────────
# The OAuth App's real client id/secret, needed to CREATE the proxy stack.
# deploy.sh refuses these all-x placeholders. On a later deploy, set both to ""
# to keep the stack's live credentials instead of replacing them.
export GITHUB_CLIENT_ID="xxxxxxxxxxxxxxxx"
export GITHUB_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Comma-separated https:// origins whose /admin may sign in: the proxy hands the
# GitHub token only to a window from one of these. A `*` may stand in for part
# of a host label, matches within ONE label, and is accepted only at or beneath
# APEX_DOMAIN above. The per-PR preview admins (preview-prN.<apex>,
# preview-cms-<slug>.<apex>) are separate origins, so they can sign in only if
# https://preview-*.<apex> is listed; deploy.sh warns when it is not. With no
# valid entry the proxy refuses every login.
export ALLOWED_ORIGINS="https://example.com,https://preview-*.example.com"
# A site that deliberately has no preview sign-in drops the preview entry and
# sets this, which turns deploy.sh's warning into a statement.
# export PREVIEW_SIGN_IN="disabled"
# STACK_NAME names the OAuth PROXY stack (oauth-proxy/deploy.sh requires it).
# The bootstrap stack is named by BOOTSTRAP_STACK_NAME instead (default
# <prefix>-bootstrap, below); infrastructure/bootstrap/deploy.sh never takes
# its stack name from this STACK_NAME and refuses a bootstrap name equal to it.
# infrastructure/README.md, "The STACK_NAME collision".
export STACK_NAME="example-com-oauth-proxy"   # oauth-proxy stack/function name

# ── Optional (sensible defaults derive from APEX_DOMAIN) ─────────────────────
# export GITHUB_ORG="Adam-S-Daniel"
# export RESOURCE_PREFIX="example-com"          # apex with dots->hyphens
# export BOOTSTRAP_STACK_NAME="example-com-bootstrap"   # bootstrap stack; default <prefix>-bootstrap
# export AWS_REGION="us-east-1"
# export HOSTED_ZONE_ID="ZXXXXXXXXXXXXX"         # auto-detected from Route53 if unset
# export PROD_PLAYGROUND_MODE="true"             # opt-in: lets the prod-mutate loop
#                                                #  actually create+delete a live canary.
#                                                #  Leave UNSET on a real prod site
#                                                #  (loop stays report-only); set "true"
#                                                #  only on a throwaway sandbox.
# export CMS_AUTOMATION_APP_ID="Iv1.0123456789abcdef"  # opt-in: the CMS automation
#                                                #  GitHub App's Client ID. With its
#                                                #  private key set as the
#                                                #  CMS_AUTOMATION_APP_PRIVATE_KEY SECRET
#                                                #  (`gh secret set`), platform-bump and
#                                                #  dev-hooks-sync mint a per-run token
#                                                #  and CMS_PLATFORM_PAT is never read
#                                                #  (cms-platform#238). A VARIABLE by
#                                                #  design, so it can be read back.

# OPTIONAL — private bucket for archived media PDFs (third-party article copies
# a site references from `_media` but must not commit to its PUBLIC repo).
# Leave unset and no bucket is created and nothing changes. Convention is the
# resource prefix plus `-media-archive`. See cms-platform docs/MEDIA-ARCHIVE.md.
# MEDIA_ARCHIVE_BUCKET=example-com-media-archive

# OPTIONAL — serve the Decap editor from its own origin (cms-platform#517), out
# of reach of the public pages' scripts. Leave unset
# and nothing changes. Setting it is a cut-over with steps on the site side
# too (cms.admin_origin, ALLOWED_ORIGINS): follow the runbook in cms-platform
# docs/ADMIN-AUTH-SECURITY.md. Unsetting it on a later deploy turns it off.
# ADMIN_DOMAIN=admin.example.com

# OPTIONAL — security headers both CloudFront distributions send (bootstrap
# stack; cms-platform#515). The defaults below need no edit. /admin/* starts
# in report-only: set ADMIN_CSP_MODE to "enforce" only after an editor
# round-trip shows no console violations (cms-platform
# docs/ADMIN-AUTH-SECURITY.md). Left unset, a redeploy keeps the mode the
# stack already has (a new stack gets report-only); set it only to change
# the mode, e.g. "report-only" to back out of enforcing. HSTS_SCOPE
# "include-subdomains" or "include-subdomains-preload" also binds every other
# host under the apex.
# export ADMIN_CSP_MODE=""                       # "enforce" or "report-only"; unset = keep deployed
# export HSTS_MAX_AGE_SECONDS="31536000"         # one year
# export HSTS_SCOPE="this-host-only"
