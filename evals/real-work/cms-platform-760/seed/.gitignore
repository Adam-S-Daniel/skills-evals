# Local harness prefs (not for the published platform). Narrowed from
# `/.claude/settings.json`: that file is no longer purely local. The fleet's
# skills-bootstrap delivery registers its SessionStart hook there, and
# `sync.sh` APPENDS to the file rather than owning it, so it now carries
# fleet-managed config that has to be tracked. Personal overrides belong in
# `settings.local.json`, which Claude Code reads and this repo still ignores.
/.claude/settings.local.json
# Real per-site deploy params (secrets) — only the .example.env is tracked
infrastructure/site-params.env
__pycache__/
*.pyc

# Node deps (installed via `cd e2e && npm ci`); package-lock.json IS tracked
node_modules/
# Ephemeral Playwright outputs
e2e/test-results/
e2e/playwright-report/
playwright-report/
test-results/
# Local Jekyll build artifacts
_site/
.jekyll-cache/
.sass-cache/
vendor/
.bundle/

# e2e local-lane self-test fixture (e2e/fixture-site/): its SOURCE is
# tracked; everything Jekyll / the theme's Decap render hook produce at
# validation time is not. (_site/, vendor/, .bundle/, .jekyll-cache/ are
# already covered above at any depth; these add the fixture-specific ones.)
# Its Gemfile.lock IS tracked (#527): the `fixture-e2e` required check
# installs from it in frozen mode, so a new upstream gem release cannot turn
# an unrelated PR red.
# The theme's decap_config_hook.rb renders these into the fixture's admin/
# at build — generated, never source.
e2e/fixture-site/admin/config.yml
e2e/fixture-site/admin/config-local.yml

# AWS SAM build output (oauth-proxy deploy)
oauth-proxy/.aws-sam/

# Claude Code session worktrees / state. NOT a blanket `.claude/` ignore:
# `_agent-guidance`'s sync commits `.claude/hooks/skills-bootstrap.sh` and
# `.claude/settings.json` here, and `git add` on an ignored path exits 1 —
# which under `set -euo pipefail` aborts the entire two-owner fleet sync at
# this repo and silently leaves every repo after it unsynced. The sync
# deliberately refuses to `git add -f` past a repo's own policy, so the
# ignore has to name the transient paths instead of the directory.
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/skills/
screenshots/
