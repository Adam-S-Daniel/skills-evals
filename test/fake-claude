#!/usr/bin/env python3
"""Fake `claude` CLI for hermetic tests — never invokes the real binary.

Reads FAKE_CLAUDE_MODE from the environment to decide which canned
--output-format json payload to print; ignores argv beyond accepting whatever
-p/--output-format/--permission-mode/--setting-sources/--model flags the
harness passes. FAKE_CLAUDE_SLEEP (seconds, default 5) controls the "timeout"
mode's sleep duration.

Note: the harness invokes CLAUDE_BIN identically for both the agent call and
the judge call, so a single script must serve both roles. The dedicated
run_agent tests use mode "agent" (plain prose result) and the dedicated
judge.score tests use "judge"/"judge_fenced"/"judge_no_overall" (JSON
result). The end-to-end orchestration test (single CLAUDE_BIN/env for the
whole `main()` invocation) instead uses "agent_and_judge", whose result is a
JSON string of judge-shaped dimensions/overall — that string is a perfectly
valid transcript for the agent call, and it's exactly what judge.score's
parser expects for the judge call, so one canned response satisfies both
subprocess invocations inside a single run.

Mode "agent_env" replies with a JSON snapshot of the probe variables the
harness's agent_env() is expected to have set (SKILLS_EVALS_PROBE, PATH).

Three modes serve the pairwise judge (skills-evals#81): "judge_pairwise"
returns a canned ranking of three blind draft labels plus per-draft
dimension scores; "judge_pairwise_incomplete" drops a label from the
ranking and "judge_pairwise_unknown_label" invents one, so the scorer's
validation has something to reject. The canned ranking is fixed while the
LABEL each draft carries is shuffled per trial by the scorer, which is what
lets a test read the shuffle back out of the resulting rank.

`--version` is handled unconditionally (regardless of FAKE_CLAUDE_MODE) so
that harness/run_canary.py's `claude --version` recording call succeeds even
when a mode simulates a failure.

Three modes simulate harness/run_canary.py's guidance-bridge canary:
  - canary_loader: mimics Claude Code's real memory loader — expands an
    `@AGENTS.md`-style import line in ./CLAUDE.md (outside fenced code
    blocks) and replies with CLAUDE.md's content plus whatever it imported.
  - canary_blind: always replies "NO-MAGIC-WORD", simulating a regressed
    loader that injects nothing.
  - canary_forager: replies with the concatenation of every *.md file in cwd
    (sorted), simulating either read-tool foraging or native AGENTS.md
    support — everything is visible regardless of layout.
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

MODE = os.environ.get("FAKE_CLAUDE_MODE", "agent")

USAGE = {
    "input_tokens": 1234,
    "output_tokens": 567,
    "cache_creation_input_tokens": 0,
    "cache_read_input_tokens": 0,
}

JUDGE_DIMENSIONS = [
    {"name": "Completeness", "score": 8, "rationale": "Filtered every workflow found."},
    {"name": "Correctness", "score": 9, "rationale": "Required check still always fires."},
    {"name": "Restraint", "score": 7, "rationale": "Left schedule-only workflows alone."},
    {"name": "Communication", "score": 6, "rationale": "Explained changes briefly."},
]


# Pairwise (#81): three drafts, labelled A/B/C by the scorer after it has
# shuffled them. B is ranked best, then A, then C — deliberately NOT the
# label order, so a scorer that ignored the ranking and took the first label
# would score differently.
PAIRWISE_RANKING = ["B", "A", "C"]

PAIRWISE_DIMENSIONS_BY_LABEL = {
    "A": [{"name": "specificity", "score": 7,
           "rationale": "Names the requisition number."},
          {"name": "register match", "score": 6,
           "rationale": "Warm, plain sign-off."},
          {"name": "absence of corporate filler", "score": 8,
           "rationale": "No buzzwords."}],
    "B": [{"name": "specificity", "score": 9,
           "rationale": "Both facts, quoted exactly."},
          {"name": "register match", "score": 9,
           "rationale": "Greets by name and hedges."},
          {"name": "absence of corporate filler", "score": 9,
           "rationale": "Nothing to strip."}],
    "C": [{"name": "specificity", "score": 3,
           "rationale": "Vague about the timing."},
          {"name": "register match", "score": 4,
           "rationale": "Reads like a form letter."},
          {"name": "absence of corporate filler", "score": 2,
           "rationale": "Buzzwords throughout."}],
}


def emit(payload: dict) -> None:
    print(json.dumps(payload))


def _load_claude_md() -> str:
    """canary_loader: expand `@file` import lines outside fenced code blocks."""
    claude_md = Path("CLAUDE.md")
    if not claude_md.is_file():
        return "NO-MAGIC-WORD"
    content = claude_md.read_text(encoding="utf-8")
    imported = []
    in_fence = False
    for line in content.splitlines():
        if line.startswith("```"):
            in_fence = not in_fence
            continue
        if not in_fence and line.startswith("@"):
            tokens = line[1:].split()
            if not tokens:
                continue
            imported_path = Path(tokens[0])
            if imported_path.is_file():
                imported.append(imported_path.read_text(encoding="utf-8"))
    return content + "".join(imported)


def main() -> int:
    if "--version" in sys.argv:
        print("fake-claude 0.0.0 (hermetic test stub)")
        return 0

    if MODE == "error":
        print("fake-claude: simulated CLI failure", file=sys.stderr)
        return 1

    if MODE == "timeout":
        time.sleep(float(os.environ.get("FAKE_CLAUDE_SLEEP", "5")))
        emit({"result": "late", "is_error": False, "usage": USAGE,
             "total_cost_usd": 0.01, "num_turns": 1, "duration_ms": 100,
             "session_id": "fake-session"})
        return 0

    if MODE == "agent_error":
        emit({
            "result": "Failed to audit the workflows: could not read .github/workflows.",
            "is_error": True,
            "usage": USAGE,
            "total_cost_usd": 0.02,
            "num_turns": 2,
            "duration_ms": 4200,
            "session_id": "fake-session",
        })
        return 0

    if MODE in ("judge", "judge_fenced", "judge_no_overall"):
        judge_json: dict = {"dimensions": JUDGE_DIMENSIONS}
        if MODE != "judge_no_overall":
            judge_json["overall"] = 7.5
        judge_text = json.dumps(judge_json)
        if MODE == "judge_fenced":
            judge_text = "```json\n" + judge_text + "\n```"
        emit({
            "result": judge_text,
            "is_error": False,
            "usage": USAGE,
            "total_cost_usd": 0.03,
            "num_turns": 1,
            "duration_ms": 800,
            "session_id": "fake-session",
        })
        return 0

    if MODE in ("judge_pairwise", "judge_pairwise_incomplete",
                "judge_pairwise_unknown_label"):
        ranking = list(PAIRWISE_RANKING)
        if MODE == "judge_pairwise_incomplete":
            ranking = ranking[:-1]
        elif MODE == "judge_pairwise_unknown_label":
            ranking = ranking[:-1] + ["Z"]
        emit({
            "result": json.dumps({"ranking": ranking,
                                  "dimensions": PAIRWISE_DIMENSIONS_BY_LABEL}),
            "is_error": False,
            "usage": USAGE,
            "total_cost_usd": 0.03,
            "num_turns": 1,
            "duration_ms": 900,
            "session_id": "fake-session",
        })
        return 0

    if MODE == "agent_env":
        # Reply with the probe variables the harness was asked to set, so a
        # test can see the fixture's `env:` block reached the subprocess with
        # $WORKSPACE expanded — and that PATH was prepended, not replaced.
        emit({"result": json.dumps({"probe": os.environ.get("SKILLS_EVALS_PROBE"),
                                    "path": os.environ.get("PATH"),
                                    "cwd": os.getcwd()}),
              "is_error": False, "usage": USAGE, "total_cost_usd": 0.01,
              "num_turns": 1, "duration_ms": 100, "session_id": "fake-session"})
        return 0

    if MODE == "agent_and_judge":
        emit({
            "result": json.dumps({"dimensions": JUDGE_DIMENSIONS, "overall": 7.5}),
            "is_error": False,
            "usage": USAGE,
            "total_cost_usd": 0.05,
            "num_turns": 2,
            "duration_ms": 5000,
            "session_id": "fake-session",
        })
        return 0

    if MODE == "canary_loader":
        emit({"result": _load_claude_md(), "is_error": False, "usage": USAGE,
             "total_cost_usd": 0.01, "num_turns": 1, "duration_ms": 100,
             "session_id": "fake-session"})
        return 0

    if MODE == "canary_blind":
        emit({"result": "NO-MAGIC-WORD", "is_error": False, "usage": USAGE,
             "total_cost_usd": 0.01, "num_turns": 1, "duration_ms": 100,
             "session_id": "fake-session"})
        return 0

    if MODE == "canary_forager":
        content = "".join(p.read_text(encoding="utf-8") for p in sorted(Path.cwd().glob("*.md")))
        emit({"result": content, "is_error": False, "usage": USAGE,
             "total_cost_usd": 0.01, "num_turns": 1, "duration_ms": 100,
             "session_id": "fake-session"})
        return 0

    # default / "agent"
    emit({
        "result": "Filtered every pull_request/push workflow on its salient paths.",
        "is_error": False,
        "usage": USAGE,
        "total_cost_usd": 0.04,
        "num_turns": 3,
        "duration_ms": 9000,
        "session_id": "fake-session",
    })
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
