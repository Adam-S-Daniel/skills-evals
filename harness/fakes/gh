#!/usr/bin/env python3
"""Offline `gh`: answer from a directory of recorded responses, never the network.

Point `$GH_REPLAY_DIR` at a directory of responses recorded from a real
repository and this replays them, keyed by the NORMALIZED command line, so a
session can be re-run on a machine with no network and no token. Three
behaviours, and nothing else:

  * READS are answered from `$GH_REPLAY_DIR`, keyed by the normalized argv
    (see `payload_key`), and classed `read`.
  * WRITES — `pr merge`, `pr close`, `workflow run`, `gh api -X POST` and
    friends — are refused with a real-shaped HTTP 403, the way a read-only
    token is refused, and classed `write`. Nothing here can mutate anything.
    The class records INTENT: a verb that would reach the network or write
    the working tree (`pr checkout`, `repo clone`, `run download`) is refused
    the same way, because what matters afterwards is what was reached for.
  * An UNKNOWN read is answered with `gh`'s own 404 and classed `unknown`,
    never a Python traceback: whoever guesses an endpoint must see what `gh`
    would have shown them, not this file's internals. The resolved key goes
    to the log only, never to stderr.

Every invocation is appended to `.gh-invocations.log` as ONE line carrying
its class, its normalized argv key, its exit code and its JSON-encoded argv,
so a replayed session can be audited from the log alone — and so no argv can
forge a second record by carrying a newline. A log that cannot be written is
swallowed, so no failure downstream costs the log its record.

The key is recorded for EVERY class, not only for the reads a file backed:
it is the identity of the normalized argv (see `payload_key`), not a claim
that a file was served. An `unknown` read logs the key that resolved to
nothing; a refused write logs the key its argv normalizes to, which is what
makes "was a write aimed at #421?" answerable mechanically — flags are
dropped from the key, so `pr close --delete-branch 421` and `pr close 421
--delete-branch` are one and the same record.

Not implemented, on purpose: `--jq`, `-q`, `--json` field selection and
`--template` are accepted and IGNORED — the whole response is returned. A
recorded response must therefore stay readable as raw JSON, and nothing here
needs a system `jq`.
"""

from __future__ import annotations

import json
import os
import re
import sys

# Flags that take no value. Everything else that looks like a flag consumes
# the next token unless that token is itself a flag — which is why this set
# has to be explicit: without it `run view --log 4471182930` would read the
# run id as `--log`'s value and key to a different payload than
# `run view 4471182930 --log`.
#
# A shorthand whose meaning DIFFERS per subcommand cannot live in this flat
# set: `-w` is boolean `--web` on `gh pr view` but `--workflow <name>` on
# `gh run list`, and a flat set gets one of them wrong whichever way it is
# listed. Such shorthands are deliberately absent; write them long-form, or
# give them a subcommand below.
BOOLEAN_FLAGS = {
    "-h", "--help", "--version", "--verbose", "-y", "--yes",
    "--log", "--log-failed", "--failed", "--exit-status", "--web", "--watch",
    "--auto", "--disable-auto", "--admin", "--merge", "--squash", "--rebase",
    "--delete-branch", "--delete-local", "--comments", "--draft",
    "--paginate", "--include", "--silent", "--slurp", "--force",
    "--fill", "--no-maintainer-edit", "--dry-run", "--preview",
}

# …and where one subcommand is the whole answer, it says so here instead of
# giving up on the shorthand. `-i` is boolean `--include` on `gh api` and
# `--interval <duration>` on `gh pr checks`; listed globally it swallows the
# duration, omitted entirely it swallows the endpoint and a plain
# `gh api -i repos/…` 404s. Keyed by the FIRST positional, which is the
# command every one of these belongs to.
SUBCOMMAND_BOOLEAN_FLAGS = {
    "api": {"-i"},
}

# The long flag each shorthand IS. gh binds both spellings to one variable,
# so `-X GET --method POST` is one flag given twice and the last one wins —
# which is only decidable if they land in the same bucket. Only the
# shorthands whose long form is consulted below are listed: the rest still
# take their value, they just keep their own name.
SHORTHAND_ALIASES = {
    "-X": "--method",
    "-R": "--repo",
    "-f": "--raw-field",
    "-F": "--field",
}

# Shorthands that take a value and that gh also accepts ATTACHED (`-XPOST`,
# `-fquery=…`, `-Rowner/repo`), the way pflag does. Split before anything
# else looks at the token: unsplit, `-XPOST` reads as an unknown flag that
# swallows the endpoint behind it, and a mutation lands in the log classed
# `unknown`.
ATTACHED_VALUE_FLAGS = ("-X", "-f", "-F", "-R", "-H", "-q", "-b", "-t", "-L")

# Flags whose presence makes a `gh api` call a write even without -X.
# Long spellings only: `-f`/`-F` are normalized to them at parse time.
API_BODY_FLAGS = {"--raw-field", "--field", "--input"}
WRITE_METHODS = {"POST", "PATCH", "PUT", "DELETE"}

# Verbs that mutate REMOTE state. A pair in neither this set nor the one
# added just below is treated as a read, so a new verb to refuse is added
# here rather than in a private copy of this file.
WRITE_SUBCOMMANDS = {
    ("pr", "merge"), ("pr", "close"), ("pr", "create"), ("pr", "edit"),
    ("pr", "comment"), ("pr", "reopen"), ("pr", "ready"), ("pr", "review"),
    ("pr", "lock"), ("pr", "unlock"), ("pr", "update-branch"),
    ("issue", "close"), ("issue", "create"), ("issue", "comment"),
    ("issue", "edit"), ("issue", "reopen"), ("issue", "delete"),
    ("issue", "pin"), ("issue", "unpin"), ("issue", "transfer"),
    ("issue", "lock"), ("issue", "unlock"),
    ("workflow", "run"), ("workflow", "enable"), ("workflow", "disable"),
    ("run", "rerun"), ("run", "cancel"), ("run", "delete"),
    ("release", "create"), ("release", "delete"), ("release", "edit"),
    ("release", "upload"),
    ("repo", "create"), ("repo", "delete"), ("repo", "edit"),
    ("repo", "rename"), ("repo", "archive"), ("repo", "unarchive"),
    ("repo", "sync"), ("repo", "fork"), ("repo", "deploy-key"),
    ("label", "create"), ("label", "delete"), ("label", "edit"),
    ("label", "clone"),
    ("secret", "set"), ("secret", "delete"),
    ("variable", "set"), ("variable", "delete"),
    ("cache", "delete"), ("gist", "create"), ("gist", "delete"),
    ("gist", "edit"), ("gist", "rename"),
    ("auth", "login"), ("auth", "logout"), ("auth", "refresh"),
    ("auth", "setup-git"), ("config", "set"), ("alias", "set"),
    ("alias", "delete"), ("extension", "install"), ("extension", "remove"),
    ("ssh-key", "add"), ("ssh-key", "delete"), ("gpg-key", "add"),
    ("gpg-key", "delete"), ("ruleset", "create"),
}

# Verbs that mutate nothing remotely but WRITE THE WORKING TREE or reach the
# network to do it. `gh release download` is a plain read against the API and
# still belongs here: what it does locally is a side effect no recorded
# response can honestly reproduce. They join the same class, because the
# class records intent.
WRITE_SUBCOMMANDS |= {
    ("pr", "checkout"), ("repo", "clone"), ("run", "download"),
    ("release", "download"), ("issue", "develop"),
}

# The endpoint each refused write would have hit, so the 403 names a real
# URL the way `gh` does. `{repo}` is the --repo flag, else $GH_REPO.
WRITE_ENDPOINTS = {
    ("pr", "merge"): "repos/{repo}/pulls/{arg}/merge",
    ("pr", "close"): "repos/{repo}/pulls/{arg}",
    ("pr", "reopen"): "repos/{repo}/pulls/{arg}",
    ("pr", "edit"): "repos/{repo}/pulls/{arg}",
    ("pr", "checkout"): "repos/{repo}/pulls/{arg}",
    ("pr", "comment"): "repos/{repo}/issues/{arg}/comments",
    ("pr", "create"): "repos/{repo}/pulls",
    ("issue", "comment"): "repos/{repo}/issues/{arg}/comments",
    ("issue", "close"): "repos/{repo}/issues/{arg}",
    ("issue", "develop"): "repos/{repo}/issues/{arg}",
    ("workflow", "run"): "repos/{repo}/actions/workflows/{arg}/dispatches",
    ("run", "rerun"): "repos/{repo}/actions/runs/{arg}/rerun",
    ("run", "cancel"): "repos/{repo}/actions/runs/{arg}/cancel",
    ("run", "download"): "repos/{repo}/actions/runs/{arg}/artifacts",
    ("release", "download"): "repos/{repo}/releases",
    ("repo", "clone"): "repos/{repo}",
    ("label", "create"): "repos/{repo}/labels",
}


def split_attached(arg: str) -> tuple[str, str] | None:
    """(`-X`, `POST`) for `-XPOST`, else None.

    Only for the shorthands gh documents as taking a value; a long flag and a
    bare shorthand are left to the caller.
    """
    if len(arg) <= 2 or arg.startswith("--"):
        return None
    if arg[:2] not in ATTACHED_VALUE_FLAGS:
        return None
    value = arg[2:]
    return arg[:2], value[1:] if value.startswith("=") else value


def parse_argv(argv: list[str]) -> tuple[list[str], dict[str, list]]:
    """Split argv into positionals and flags.

    Flags are dropped from the payload key entirely, which is what makes
    argv ORDER irrelevant: `pr list --repo X --state open` and
    `pr list --state open --repo X` normalize to the same positionals.
    `--flag=value` is one token, `-Xvalue` is split into flag and value, and
    a boolean flag never eats a positional. A shorthand that gh binds to a
    long flag is recorded under the LONG name (see `SHORTHAND_ALIASES`), so
    the two spellings of one flag stay in argv order in one list.

    Which flags are boolean depends on the command: `SUBCOMMAND_BOOLEAN_FLAGS`
    is consulted against the first positional seen so far, which is the
    command itself (`gh api -i …`).
    """
    positionals: list[str] = []
    flags: dict[str, list] = {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            positionals.extend(argv[i + 1:])
            break
        if arg.startswith("-") and arg != "-":
            attached = split_attached(arg)
            if attached:
                flags.setdefault(SHORTHAND_ALIASES.get(attached[0], attached[0]),
                                 []).append(attached[1])
                i += 1
                continue
            name, eq, value = arg.partition("=")
            key = SHORTHAND_ALIASES.get(name, name)
            booleans = BOOLEAN_FLAGS | SUBCOMMAND_BOOLEAN_FLAGS.get(
                positionals[0] if positionals else "", set())
            if eq:
                flags.setdefault(key, []).append(value)
            elif name in booleans:
                flags.setdefault(key, []).append(True)
            elif i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                flags.setdefault(key, []).append(argv[i + 1])
                i += 1
            else:
                flags.setdefault(key, []).append(True)
        else:
            positionals.append(arg)
        i += 1
    return positionals, flags


def last(flags: dict[str, list], *names: str) -> str | None:
    """The LAST value given for any of `names`, or None.

    gh is last-wins: `-X GET -X POST` sends the POST, because both tokens
    bind one variable and the second assignment overwrites the first. Taking
    the FIRST value classed that call `read` and let a mutation through
    unrecorded. Shorthands are normalized to their long spelling in
    `parse_argv`, so "last" is unambiguous within one name.
    """
    for name in names:
        values = [value for value in flags.get(name, []) if value is not True]
        if values:
            return str(values[-1])
    return None


def payload_key(positionals: list[str], flags: dict[str, list]) -> str | None:
    """The payload file the normalized argv names, relative to the payload dir.

    Two rules, and they are the whole contract:

      * `api <endpoint>`   -> `api/<endpoint>.json`
        (`repos/o/r/pulls/7` -> `api/repos/o/r/pulls/7.json`; a leading
        slash and a `?query` are stripped first)
      * anything else      -> the positionals joined with `-`, plus `.json`
        (`pr list ...` -> `pr-list.json`; `pr view 418 ...` ->
        `pr-view-418.json`; `run view 12 --log` -> `run-view-12.log`)

    Only `api` nests. Any other verb's positionals are flattened — a `/` in
    one of them (`repo view owner/name`) becomes a `-`, so every non-`api`
    payload is one flat file and no key can name a directory nobody meant to
    create.

    `--log` / `--log-failed` are the only flags that reach the key, and only
    by choosing the extension: a run's log is a different artifact from its
    JSON summary, not a different command.
    """
    if not positionals:
        return None
    if positionals[0] == "api":
        if len(positionals) < 2:
            return None
        endpoint = positionals[1].split("?", 1)[0].strip("/")
        if not endpoint:
            return None
        return f"api/{endpoint}.json"
    suffix = ".log" if ("--log" in flags or "--log-failed" in flags) else ".json"
    flat = [token.replace("/", "-").replace(os.sep, "-") for token in positionals]
    return "-".join(flat) + suffix


def resolve_payload(payload_dir: str, key: str) -> str | None:
    """The absolute path `key` names, or None if it escapes or is absent.

    A key is built from the caller's argv, so `api ../../etc/passwd` has to
    resolve to nothing rather than to a file outside the payload directory.
    """
    root = os.path.realpath(payload_dir)
    # A `.json` key falls back to `.txt`, so a command whose real output is
    # plain text (`gh auth status`, `gh pr diff`) gets a payload named for
    # what it holds. The key is unchanged either way — only the file is.
    names = [key, key[: -len(".json")] + ".txt"] if key.endswith(".json") else [key]
    for name in names:
        candidate = os.path.realpath(os.path.join(root, name))
        if candidate != root and not candidate.startswith(root + os.sep):
            return None
        if os.path.isfile(candidate):
            return candidate
    return None


def api_flags(positionals: list[str], flags: dict[str, list]) -> dict[str, list]:
    """`flags`, plus anything flag-shaped written after a `--`.

    `--` ends gh's own flag parsing, so `gh api -- <endpoint> -X POST` is
    not a POST as far as gh is concerned — but it is one the caller reached
    for, and the class records INTENT, so classification reads behind the
    `--` too. Only classification: the payload key is built from the
    endpoint, which is the first positional either way. The trailing values
    are appended, so last-wins still means what it says.
    """
    if len(positionals) <= 2:
        return flags
    _, trailing = parse_argv(positionals[2:])
    merged = {name: list(values) for name, values in flags.items()}
    for name, values in trailing.items():
        merged.setdefault(name, []).extend(values)
    return merged


# A GraphQL document declares its operation; `mutation` is the only one that
# writes. (`query` and `subscription` do not, and an anonymous `{ … }`
# document is a query.)
GRAPHQL_MUTATION_RE = re.compile(r"\bmutation\b")


def graphql_mutates(flags: dict[str, list]) -> bool:
    """Does the `query=` field of a `gh api graphql` call declare a mutation?

    Conservative in the direction that matters: a document this cannot read
    (`-F query=@file.graphql`, or no query field at all) counts as no
    mutation, so an ordinary read is never refused with a 403 nobody meant
    to provoke. What has to be caught here says `mutation` in the document.
    """
    for name in ("--raw-field", "--field"):
        for value in flags.get(name, []):
            if value is True:
                continue
            field, _, document = str(value).partition("=")
            if field.strip() == "query" and GRAPHQL_MUTATION_RE.search(document):
                return True
    return False


def classify(positionals: list[str], flags: dict[str, list]) -> str:
    """`write` if this invocation would mutate anything, else `read`."""
    if not positionals:
        return "read"
    if positionals[0] == "api":
        return classify_api(positionals, api_flags(positionals, flags))
    pair = (positionals[0], positionals[1] if len(positionals) > 1 else "")
    return "write" if pair in WRITE_SUBCOMMANDS else "read"


def classify_api(positionals: list[str], flags: dict[str, list]) -> str:
    """`gh api`'s own class, from its endpoint, method and body fields."""
    endpoint = (positionals[1].split("?", 1)[0].strip("/")
                if len(positionals) > 1 else "")
    if endpoint == "graphql":
        # Every graphql call is a POST on the wire, so the method says
        # nothing about it and the body flags say only that a document was
        # handed over. The DOCUMENT decides: `-f query=query{…}` reads a
        # merge state and nothing more, and answering that with a 403 would
        # be this file's mistake, not the caller's.
        return "write" if graphql_mutates(flags) else "read"
    method = last(flags, "--method")
    if method is not None:
        # An explicit method decides it on its own. `-X GET … -f k=v` is
        # gh's documented read idiom (on GET the fields go to the query
        # string, not a body), so the body flags must not override it.
        return "write" if method.upper() in WRITE_METHODS else "read"
    # No method: gh implies POST as soon as a body field is present.
    if any(name in flags for name in API_BODY_FLAGS):
        return "write"
    return "read"


def write_endpoint(positionals: list[str], flags: dict[str, list]) -> str:
    """The API URL path a refused write would have hit."""
    repo = last(flags, "--repo") or os.environ.get("GH_REPO", "OWNER/REPO")
    if positionals and positionals[0] == "api":
        return positionals[1].split("?", 1)[0].strip("/") if len(positionals) > 1 else "graphql"
    pair = (positionals[0], positionals[1] if len(positionals) > 1 else "")
    template = WRITE_ENDPOINTS.get(pair, "repos/{repo}")
    arg = positionals[2] if len(positionals) > 2 else ""
    return template.format(repo=repo, arg=arg)


def resolve_log_dir() -> str:
    """Where `.gh-invocations.log` goes, settled once, at start-up.

    The checkout the replay directory sits in — and deliberately NOT
    `$WORKSPACE`, which used to win when it was set. Both `$WORKSPACE` and
    the cwd are things the shell running this can point somewhere else for
    one command, and a record that can be moved out of the tree for one
    command is not a record: everything written before the move still sits
    in the file a reader looks at, so only the moved call goes missing.
    `$GH_REPLAY_DIR` cannot be moved without also moving the responses,
    which is a change the caller cannot hide.

    A replay directory may live in a dot-directory (`.gh/replay`) so the
    checkout still reads as an ordinary one; the log belongs beside the
    checkout, not inside it. With no replay directory at all there is
    nothing to sit beside, and the cwd is the last resort.
    """
    payloads = os.environ.get("GH_REPLAY_DIR")
    if payloads:
        parent = os.path.dirname(os.path.abspath(payloads))
        if os.path.basename(parent).startswith("."):
            parent = os.path.dirname(parent)
        return parent
    return os.getcwd()


# Read once, before anything else runs, so nothing later in this process can
# move it either.
LOG_DIR = resolve_log_dir()


def one_line(text: str) -> str:
    """`text` with everything that could break the one-record-one-line rule
    escaped: newlines, tabs, spaces and anything non-printable."""
    return text.encode("unicode_escape").decode("ascii").replace(" ", "\\x20")


LOG_NAME = ".gh-invocations.log"


def render_record(argv: list[str], klass: str, key: str | None, code: int) -> bytes:
    """The ONE line this invocation is worth, ready to append.

    The argv is JSON-encoded: an argv element carrying a newline would
    otherwise write extra records, and a pattern matched over the log could
    be satisfied without the command ever having run. `json.dumps` escapes
    the newline instead, so a reader anchoring its patterns at `^` cannot be
    fooled by anything inside an argv. The key is built from argv too, so it
    is escaped the same way: one record, one line, whatever was typed.
    """
    safe = [a.encode("utf-8", "backslashreplace").decode("utf-8") for a in argv]
    field = one_line(key) if key else "-"
    record = (f"--- invocation (class={klass} key={field} exit={code}) "
              f"--- {json.dumps(safe)}\n")
    return record.encode("utf-8", "backslashreplace")


def log_invocation(argv: list[str], klass: str, key: str | None,
                   code: int) -> int | None:
    """Append ONE record to `<LOG_DIR>/.gh-invocations.log`.

    Returns the byte offset the record starts at, so a caller that ends up
    exiting with a DIFFERENT code can correct it (see `amend_exit`), or
    None if nothing was written.

    Nothing raised here may reach the caller: the record is the only
    evidence of what ran, and a run that could not be logged must still
    behave exactly like one that could.
    """
    try:
        with open(os.path.join(LOG_DIR, LOG_NAME), "ab") as handle:
            handle.seek(0, os.SEEK_END)
            offset = handle.tell()
            handle.write(render_record(argv, klass, key, code))
        return offset
    except Exception:  # noqa: BLE001 — a log we cannot write changes nothing
        return None


def amend_exit(offset: int | None, argv: list[str], klass: str,
               key: str | None, was: int, code: int) -> None:
    """Correct a record's `exit=` to the code the caller actually got.

    The record goes down BEFORE any output, which is what keeps it when the
    output fails — but the code in it is then the one this was about to
    return, not the one that came out. Rewritten in place, and only while
    the record is still the last thing in the file: with two of these
    running at once, another's record must never be truncated away. Every
    failure is swallowed, exactly like the write that put it there.
    """
    if offset is None or code == was:
        return
    try:
        with open(os.path.join(LOG_DIR, LOG_NAME), "r+b") as handle:
            handle.seek(offset)
            if handle.read() != render_record(argv, klass, key, was):
                return
            handle.seek(offset)
            handle.write(render_record(argv, klass, key, code))
            handle.truncate()
    except Exception:  # noqa: BLE001 — see log_invocation
        pass


def emit(text: str) -> int:
    """Write `text` to stdout and flush it here; 0 on success, 1 on failure.

    Flushed here on purpose: left to the interpreter, a stdout that cannot
    be flushed (a full disk, a closed pipe) reports it at shutdown, in a
    message about this file's internals, and exits 120 whatever was
    returned. Caught here, the caller gets a plain exit code and the log
    gets the truth.
    """
    try:
        sys.stdout.write(text)
        sys.stdout.flush()
    except (OSError, ValueError):
        return 1
    return 0


def refuse_write(positionals: list[str], flags: dict[str, list]) -> int:
    """The 403 a read-only token gets. Realistic wording; no side effect."""
    endpoint = write_endpoint(positionals, flags)
    verb = " ".join(positionals[:2])
    sys.stderr.write(
        f'failed to run "gh {verb}": HTTP 403: Resource not accessible by '
        f"personal access token (https://api.github.com/{endpoint})\n"
        "gh: the token available here has read-only scopes.\n"
    )
    return 1


def not_found() -> int:
    """`gh`'s own 404, for a read with no recorded response.

    Deliberately says nothing about the replay directory or the key: the
    resolved key goes to the log, and never to stderr, where it would say
    that this is a replay rather than `gh` itself.
    """
    sys.stderr.write("gh: Not Found (HTTP 404)\n")
    return 1


# What `gh --version` reports. Answered without a recorded response: every
# `gh` answers this, and a 404 here would read as "the tool is broken" and
# derail a session before it reached anything real. Bare `gh` prints the
# usage and exits 0, the way the real one does.
GH_VERSION = "gh version 2.81.0 (2026-08-19)\nhttps://github.com/cli/cli/releases/latest\n"
GH_USAGE = (
    "Work seamlessly with GitHub from the command line.\n"
    "\nUSAGE\n  gh <command> <subcommand> [flags]\n"
    "\nCORE COMMANDS\n  api, issue, pr, release, repo, run, ruleset, workflow\n"
)


def main(argv: list[str]) -> int:
    payload_dir = os.environ.get("GH_REPLAY_DIR")
    positionals, flags = parse_argv(argv)

    # Answered before any payload lookup, and only when they are the whole
    # invocation — `gh pr view --help` still keys to a payload.
    if not positionals:
        version = "--version" in flags
        offset = log_invocation(argv, "read", None, 0)
        return finish(offset, argv, "read", None,
                      emit(GH_VERSION if version else GH_USAGE))

    key = payload_key(positionals, flags)
    klass = classify(positionals, flags)

    if klass == "write":
        log_invocation(argv, "write", key, 1)
        return refuse_write(positionals, flags)

    path = resolve_payload(payload_dir, key) if (payload_dir and key) else None
    if path is not None:
        try:
            with open(path, encoding="utf-8") as handle:
                payload = handle.read()
        except (OSError, UnicodeDecodeError):
            # A response that will not read is a response that is not there.
            # UnicodeDecodeError is not an OSError, so it used to escape to
            # the top-level handler: this file's internals on stderr, and no
            # record of the call at all.
            path = None
    if path is None:
        log_invocation(argv, "unknown", key, 1)
        return not_found()

    # The record goes down before the payload does: an output that fails
    # (a closed pipe, a full disk) must not cost the log its evidence. If
    # the output does fail, `finish` corrects the code the record carries.
    offset = log_invocation(argv, "read", key, 0)
    return finish(offset, argv, "read", key, emit(payload))


def finish(offset: int | None, argv: list[str], klass: str, key: str | None,
           code: int) -> int:
    """Return `code`, having corrected the record if the output failed.

    Ends the process itself on failure: stdout still holds what could not be
    written, and letting the interpreter discover that at shutdown prints
    its own error and exits 120 whatever this returns — which would leave
    the log naming a code the caller never saw, the very thing the
    correction exists to stop.
    """
    if code == 0:
        return 0
    amend_exit(offset, argv, klass, key, 0, code)
    sys.stderr.flush()
    os._exit(code)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except BaseException as exc:  # noqa: BLE001
        # A caller must never see this file's internals: a traceback here
        # teaches them about this file, not about `gh`.
        sys.stderr.write(f"gh: unexpected error: {type(exc).__name__}: {exc}\n")
        raise SystemExit(1)
